{
  // Yalnızca bildiğimiz portları ilet. Turbopack/Node işçi süreçleri
  // rastgele yüksek portlar açıyor ve VS Code hepsini otomatik iletip
  // "Bağlantı Noktaları" panelini bayat kayıtlarla dolduruyordu.
  "remote.otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "remote.portsAttributes": {
    "3000": { "label": "Supsto — uygulama", "onAutoForward": "notify" },
    "54321": { "label": "Supabase API", "onAutoForward": "silent" },
    "54322": { "label": "Supabase veritabanı", "onAutoForward": "silent" },
    "54323": { "label": "Supabase Studio", "onAutoForward": "silent" },
    "54324": { "label": "Mailpit (e-posta)", "onAutoForward": "silent" }
  },

  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "lib/types/database.ts": true
  },
  // Üretilmiş dosyalar dosya izleyicisini meşgul etmesin — düşük
  // çekirdekli ortamda CPU'yu boşuna tüketiyor.
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/supabase/.branches/**": true,
    "**/supabase/.temp/**": true
  },

  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": false
}
