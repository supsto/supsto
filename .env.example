# Supabase — `npx supabase start` çıktısındaki değerler ya da
# cloud projesi için Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Tarayıcıya açılan okuma anahtarı. Supabase adlandırmayı değiştirdi:
# yeni projeler `sb_publishable_...` üretir, eskiler `anon` JWT'si.
# İkisi de kabul edilir; PUBLISHABLE tanımlıysa o kullanılır.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca sunucuda kullanılır, asla NEXT_PUBLIC_ ile başlamamalı.
# RLS'i baypas eder — istemciye sızdırmayın.
SUPABASE_SERVICE_ROLE_KEY=

# Uygulamanın kendi adresi (e-posta doğrulama linkleri için).
# Vercel'de tanımsız kalırsa doğrulama e-postaları localhost'a yönlenir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yalnızca tarayıcı ile sunucunun FARKLI adres kullandığı ortamlarda
# (ör. GitHub Codespaces port yönlendirmesi). Tek adresli ortamlarda
# tanımlamayın — yanlış tanımlanırsa sunucu başka veritabanına bakar.
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
